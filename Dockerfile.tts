# TTS server for Kokoro (e.g. iOS / devices that can't run Kokoro in-browser).
# Same stack as the web app; Traefik exposes at tts.${HOST}.
# Use glibc-based image: onnxruntime-node (used by kokoro-js/transformers) has no Alpine/musl builds;
# on Alpine you get "Error loading shared library ld-linux-x86-64.so.2" at startup.
FROM node:20-bookworm-slim

WORKDIR /app

# Dependencies (Kokoro + transformers)
COPY package.json package-lock.json* ./
RUN npm ci

# App code and download Kokoro model into image
COPY . .
RUN npm run download-kokoro-model

EXPOSE 3333

CMD ["node", "server/tts-server.js"]
