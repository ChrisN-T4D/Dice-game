{
  "name": "discover-between-us",
  "version": "0.8",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "node scripts/copy-public-assets.js && node scripts/list-music.js && vite build",
    "build:site-root": "node scripts/copy-public-assets.js && node scripts/list-music.js && vite build --base /",
    "preview": "vite preview",
    "download-onnx-wasm": "node scripts/download-onnx-wasm.js",
    "download-kokoro-model": "node scripts/download-kokoro-model.js",
    "list-music": "node scripts/list-music.js",
    "generate-static-wavs": "node scripts/generate-static-wavs.js",
    "generate-static-sensate-phase1-non-genital": "node scripts/generate-static-wavs.js --local --sensate-preset phase1_non_genital --skip-existing",
    "generate-static-sensate-phase1-genital-included": "node scripts/generate-static-wavs.js --local --sensate-preset phase1_genital_included --skip-existing",
    "generate-voice-test-wavs": "node scripts/generate-voice-test-wavs.js",
    "generate-static-intro-no-clothing": "node scripts/generate-static-intro-no-clothing.js",
    "generate-static-intro-with-clothing": "node scripts/generate-static-intro-with-clothing.js",
    "generate-static-next-turn": "node scripts/generate-static-next-turn.js",
    "generate-static-turn-begins": "node scripts/generate-static-turn-begins.js",
    "generate-static-ease-in": "node scripts/generate-static-ease-in.js",
    "generate-static-session-complete": "node scripts/generate-static-session-complete.js",
    "generate-static-settle-into-position": "node scripts/generate-static-settle-into-position.js",
    "generate-static-phase-checkin": "node scripts/generate-static-phase-checkin.js",
    "generate-all": "node scripts/run-generate-sequence.js",
    "check-static-wavs": "node scripts/check-static-wavs.js",
    "generate-static-script-review": "node scripts/generate-static-script-review.js",
    "generate-prompt-catalog": "node scripts/generate-spoken-prompt-catalog.js",
    "pack-audio-assets": "node scripts/pack-audio-assets.js",
    "test:kokoro-ort": "node scripts/test-kokoro-ort.js",
    "compare-tokenize": "node scripts/compare-tokenize-and-inspect-onnx.js",
    "run-tokenize-path-onnx": "node scripts/run-tokenize-path-onnx-node.js",
    "debug:kokoro-ort": "node scripts/test-kokoro-ort.js",
    "debug:compare-tokenize": "node scripts/compare-tokenize-and-inspect-onnx.js",
    "debug:tokenize-path-onnx": "node scripts/run-tokenize-path-onnx-node.js",
    "db:migrate": "node scripts/db-migrate.mjs",
    "db:seed": "node scripts/seed-anatomy.mjs",
    "validate:anatomy-profiles": "node scripts/validate-anatomy-profiles.mjs",
    "audit:anatomy-profiles": "node scripts/audit-anatomy-profiles.mjs",
    "actions:seed": "node scripts/seed-anatomy-actions.mjs",
    "validate:anatomy-actions": "node scripts/validate-anatomy-actions.mjs",
    "audit:anatomy-actions": "node scripts/audit-anatomy-actions.mjs",
    "audit:anatomy-sequences": "node scripts/audit-anatomy-sequences.mjs",
    "db:setup": "npm run db:migrate && npm run db:seed && npm run actions:seed",
    "api:dev": "node server/src/index.js",
    "api:stop": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/stop-port.ps1 3001",
    "test:anatomy-api": "node scripts/test-anatomy-api.mjs"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.5.1",
    "edge-tts-client": "^1.0.2",
    "espeak-ng": "1.0.2",
    "kokoro-js": "^1.2.1",
    "onnxruntime-web": "^1.24.2",
    "pinia": "^2.1.0",
    "vue": "^3.4.0",
    "vue-router": "^4.6.4",
    "wavefile": "11.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.5",
    "tar": "^7.4.3",
    "vite": "^8.0.3"
  }
}
